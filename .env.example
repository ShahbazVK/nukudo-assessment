# Travel Disruption Assessor - environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit keys.
#   cp .env.example .env

# --- Data source credentials -------------------------------------------------
# Aviationstack (flight schedules/status) - https://aviationstack.com
# Free tier: 100 requests/month, real-time flights only; no historical or future
# schedules, so a non-today travel date is reported as unavailable (plan_limit or
# no_data_for_query) rather than guessed at.
AVIATIONSTACK_API_KEY=

# TomTom Traffic (road incidents around each airport) - https://developer.tomtom.com
# Free tier: the pricing page lists 2.5K requests/month for the Traffic APIs (older
# docs said 2,500/day). Incident Details v5 is the only endpoint this source calls,
# with two requests per assessment (origin + destination).
# The incident feed is real-time: today and tomorrow are served (tomorrow is flagged
# as indicative), anything further out is reported as unavailable/no_data_for_query.
TOMTOM_API_KEY=

# NWS (National Weather Service) needs NO API key, but the API requires a
# descriptive User-Agent identifying your application and a contact address.
# Format: "(app-name, contact@example.com)"
NWS_USER_AGENT=(travel-disruption-assessor, you@example.com)

# GDELT news/events (optional, planned) needs no key.
# GDELT_ENABLED=false

# --- AI fusion layer ---------------------------------------------------------
# Fusion calls an OpenAI-compatible /chat/completions endpoint, not DeepSeek's API
# specifically. `FUSION_MODEL_PROVIDER` picks the auth/request shape:
#   openai_compatible  any OpenAI-compatible endpoint (free hosted model, local server)
#   deepseek           DeepSeek's own API
FUSION_MODEL_PROVIDER=openai_compatible
# The model id, e.g. a free hosted model. Left empty here on purpose: fusion refuses to
# run with no model name rather than guessing one.
FUSION_MODEL_NAME=
# Endpoint + key for the fusion model. Both fall back to the DEEPSEEK_* values below, so
# setting only those still works; set these to point fusion somewhere else.
# FUSION_MODEL_BASE_URL=https://api.deepseek.com
# FUSION_MODEL_API_KEY=
# A key containing an obvious placeholder marker ("skip", "changeme", ...) is reported
# as unusable by config.fusion_readiness() and is never spent on a request.
# Prompt-size guard: signals per source sent to the model (ranked by severity, then
# distance). Free hosted tiers meter reasoning tokens against the same budget, so a
# small cap keeps one call inside it. Default is 25.
# FUSION_MAX_SIGNALS_PER_SOURCE=3

# Legacy DeepSeek names, kept so an existing .env keeps working.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Superseded by FUSION_MODEL_NAME for the actual call; retained for compatibility.
# Brief mentions "deepseek-flash" / "deepseek-v4-flash".
DEEPSEEK_MODEL=deepseek-flash

# --- Runtime settings -------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
# Retry backoff for transport failures and retryable statuses (429/5xx):
# delay = min(BACKOFF_BASE * 2**attempt, BACKOFF_MAX); a Retry-After header wins.
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=4
# Persist raw API responses to logs/raw/ for evidence traceability.
# Turning this off makes results untraceable, so sources then report an explicit
# error state instead of returning data that cannot be traced to its source.
LOG_RAW_RESPONSES=true
LOG_LEVEL=INFO
# Evidence display limits: bodies are stored in full, truncated only when surfaced.
EVIDENCE_BODY_MAX_CHARS=4000
EVIDENCE_VALUE_MAX_CHARS=500

# Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000

# Frontend (Streamlit) -> backend base URL
BACKEND_URL=http://127.0.0.1:8000
